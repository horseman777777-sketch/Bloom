<Project Sdk="Microsoft.NET.Sdk">

  <!-- Bloom's automated checks: a small console runner (no test framework, no NuGet, like the app).
       Run it with "dotnet run" on this project; the exit code is the number of failed checks (0 = all passed). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Bloom\Bloom.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- the exes' manifests, read by WinKeyHelperTests.ManifestsAreXml -->
    <None Include="..\..\src\Bloom\app.manifest" Link="Manifests\Bloom.manifest" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\WinKeyHelper\app.manifest" Link="Manifests\WinKeyHelper.manifest" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
